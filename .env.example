# --- TRIDENT configuration -------------------------------------------------
# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Server bind. Keep on localhost unless you fully understand the exposure.
TRIDENT_HOST=127.0.0.1
TRIDENT_PORT=8000

# --- AI provider (OpenAI-compatible) ---------------------------------------
# Leave AI_API_KEY empty to run deterministically without AI interpretation.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TEMPERATURE=0
AI_TIMEOUT=60
AI_MAX_TOKENS=1200

# --- Consent to send a redacted digest + question text to the provider -----
# The raw .pka is NEVER sent. Only a compact device/interface/routes digest.

# --- Limits ----------------------------------------------------------------
TRIDENT_MAX_FILE_BYTES=67108864
TRIDENT_MAX_QUESTIONS=500
TRIDENT_MAX_QUESTION_CHARS=8000
TRIDENT_PARSER_TIMEOUT=90

# --- Consensus -------------------------------------------------------------
# strict      : VERIFIED requires 3 agreeing engines (default)
# two_engine  : VERIFIED requires 2 (use only when you know one engine is absent)
# deterministic: allows VERIFIED_DERIVED from a single trusted derivation
TRIDENT_CONSENSUS_POLICY=strict

# --- Engine C (pt-convert) -------------------------------------------------
# pt-convert is All-Rights-Reserved. Point this at YOUR OWN checkout and only
# run it if you have permission. Leave empty to mark the engine UNAVAILABLE.
TRIDENT_PT_CONVERT_DIR=
# TRIDENT_NODE=node

# --- Engine A native library (optional override) ---------------------------
# LIBTWOFISH=/absolute/path/to/libtwofish.dylib
